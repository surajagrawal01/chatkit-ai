# Copy this file to .env and add your own Gemini API key.
# Do not commit .env or put secrets in NEXT_PUBLIC_* variables.
GEMINI_API_KEY=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Used when running Next.js directly on your host (npm run dev).
# Keep the port in sync with POSTGRES_PORT below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatkit

# Used by the app container. `postgres` is the Compose service hostname;
# container-to-container traffic always uses PostgreSQL's port 5432.
APP_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/chatkit

# PostgreSQL container and host port mapping.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatkit
POSTGRES_PORT=5432

# Host port mapped to the app container's port 3000.
APP_PORT=3000

# `local` keeps limits in a per-process in-memory Map.
# Use `redis` only after configuring a reachable Redis endpoint below.
RATE_LIMIT_STORAGE=local

# Optional Redis endpoints. Compose uses APP_REDIS_URL; direct host runs use
# REDIS_URL. This Compose project does not start a Redis container.
APP_REDIS_URL=
REDIS_URL=